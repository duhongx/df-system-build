<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
{{$d := .Presentation}}<title>{{$d.Name}} · HIS 运维巡检报告</title>
<style>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#edf1f6;color:#243348;font:14px/1.75 Arial,"PingFang SC","Microsoft YaHei",sans-serif}main{max-width:1200px;margin:32px auto;background:#fff;padding:40px 48px;border:1px solid #dce3ec}h1{font-size:29px;line-height:1.4;margin:12px 0 18px}h2{font-size:21px;margin:35px 0 14px;border-bottom:1px solid #dce3ec;padding-bottom:10px}h3{font-size:16px;margin:22px 0 10px}h4{font-size:14px;margin:16px 0 8px}p{margin:8px 0}a{color:#245ba5;text-decoration:none}a:hover{text-decoration:underline}.eyebrow,.meta,.note{font-size:12px;color:#68788e}.meta{line-height:2}.summary{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin:24px 0}.summary div{padding:15px;background:#f4f7fb;border:1px solid #e0e7ef}.summary strong{font-size:25px;display:block;color:#243348}.badge{display:inline-block;padding:2px 8px;border-radius:4px;background:#edf1f5;font-size:12px;white-space:nowrap}.NORMAL{background:#e9f6ee;color:#246844}.WARNING{background:#fff2d6;color:#83570c}.CRITICAL{background:#fce6e6;color:#ac2929}.UNKNOWN{background:#eef0f4;color:#586578}.NOT_APPLICABLE{background:#f0f0f0;color:#69717b}table{border-collapse:collapse;width:100%;font-size:12px;margin:12px 0 16px;table-layout:auto}th,td{text-align:left;border:1px solid #dce3ec;padding:9px 10px;vertical-align:top;overflow-wrap:anywhere;word-break:break-word}th{background:#edf3fa;color:#304d70;font-weight:600}tbody tr:nth-child(even){background:#fafbfd}.pod-table{table-layout:fixed}.pod-table th:first-child,.pod-table td:first-child{width:45%}.table-scroll{overflow-x:auto}.catalogue th:first-child{width:110px}.catalogue th:nth-child(3){width:85px}.catalogue th:nth-child(4){width:115px}.finding{border-left:3px solid #d3dce8;padding-left:16px;margin:20px 0}.finding.CRITICAL-line{border-color:#c34c4c}.finding.WARNING-line{border-color:#ce9f36}.evidence,.object{scroll-margin-top:20px}.evidence{border-top:1px solid #e2e8f0;padding:16px 0}.gap{color:#975b11}.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:16px 0}.filter{position:absolute;opacity:0;pointer-events:none}.toolbar label{cursor:pointer;background:#f2f5f9;padding:5px 12px;border:1px solid #dce3ec;border-radius:4px}.filter:focus-visible+label{outline:2px solid #245ba5}#all:checked~.toolbar label[for=all],#abnormal:checked~.toolbar label[for=abnormal],#unknown:checked~.toolbar label[for=unknown]{background:#245ba5;color:#fff}#abnormal:checked~.details .manual[data-status=NORMAL],#abnormal:checked~.details .manual[data-status=NOT_APPLICABLE],#unknown:checked~.details .manual:not([data-missing=true]){display:none}pre{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;background:#f5f7fa;border:1px solid #e1e7ef;padding:14px;font:12px/1.7 monospace;max-height:650px;overflow:auto}details summary{cursor:pointer;color:#315d91}nav{display:flex;gap:18px;flex-wrap:wrap;padding:15px 0;border-top:1px solid #dce3ec;border-bottom:1px solid #dce3ec}.foot{font-size:11px;color:#758399;margin-top:30px;border-top:1px solid #dce3ec;padding-top:14px}.priority{font-weight:600}.scope{font-size:12px;color:#68788e}.table-title{font-size:12px;font-weight:600;margin-top:16px}ul{padding-left:20px}@page{size:A4;margin:16mm}@media(max-width:800px){main{padding:20px;margin:0}.summary{grid-template-columns:repeat(3,1fr)}}@media print{body{background:#fff}main{max-width:none;border:0;padding:0;margin:0}.toolbar{display:none}.filter~.details .manual{display:block!important}pre{max-height:none}h2,h3,h4{break-after:avoid}tr{break-inside:avoid}thead{display:table-header-group}.summary{grid-template-columns:repeat(6,1fr)}a{color:inherit}}
</style></head><body><main>
<div class="eyebrow">CLOUDHIS · HIS 运维巡检 · 报告版本 {{$d.Version}}</div>
<h1>{{$d.Name}}</h1>
<div class="meta">任务 #{{$d.RunID}}　发起人：{{$d.Operator}}　对象数：{{len $d.Objects}}<br>本次采集：{{time $d.StartedAt}} ～ {{time $d.FinishedAt}}<br>结果冻结时间：{{time $d.GeneratedAt}}</div>
<h2 id="overview">整体结论</h2><p class="priority">{{$d.Conclusion}}</p>
<div class="summary"><div>已记录待核对<strong>{{$d.Summary.Recorded}}</strong></div><div>提醒<strong>{{$d.Summary.Warning}}</strong></div><div>严重<strong>{{$d.Summary.Critical}}</strong></div><div>结果不完整<strong>{{$d.Summary.Unknown}}</strong></div><div>不适用<strong>{{$d.Summary.NotApplicable}}</strong></div><div>已取得结果<strong>{{$d.Summary.Completed}} / {{$d.Summary.Planned}}</strong></div></div>
<p class="scope">按已登记连接与服务器执行只读检查，保存本次实际返回。已取得完整结果 {{$d.Summary.Completed}} / {{$d.Summary.Planned}} 项；“已记录”不等于业务正常，失败和未执行项保留具体原因。</p>
{{template "table" (components $d)}}
{{if eq $d.Mode "configured"}}{{template "table" (attention $d)}}{{else}}<h2>本次需关注的项目</h2><table><thead><tr><th>检查项／对象</th><th>状态</th><th>实际情况</th></tr></thead><tbody>{{range $d.Findings}}<tr><td>{{.Name}} · {{.ObjectName}}</td><td>{{status .Status}}</td><td>{{.Value}}<br>{{.Reason}}</td></tr>{{else}}<tr><td colspan="3">本次已取得结果中没有按指导书条件识别出的异常；未执行项目见附录。</td></tr>{{end}}</tbody></table>
{{end}}
<nav><a href="#objects">执行对象</a>{{range sections $d}}<a href="#{{.ID}}">{{.Name}}</a>{{end}}{{if ne $d.Mode "configured"}}<a href="#catalogue">附录检查目录</a>{{end}}</nav>
<h2 id="objects">执行对象</h2><p class="scope">本次选择的服务器、数据库及实际执行服务器。</p>
<table><thead><tr><th>对象</th><th>类型</th><th>登记地址</th><th>执行服务器</th><th>执行状态</th></tr></thead><tbody>{{range $d.Objects}}<tr><td><a href="#object-{{.ID}}">{{.Name}}</a></td><td>{{.Type}}</td><td>{{.Endpoint}}</td><td>{{.ExecutorEndpoint}}</td><td>{{status .Status}}{{if .Message}}<br>{{.Message}}{{end}}</td></tr>{{end}}</tbody></table>
{{range $section := sections $d}}<section id="{{$section.ID}}"><h2>{{$section.Name}}</h2><p class="scope">{{$section.Intro}}</p>{{if eq $section.ID "resources"}}{{if eq $d.Mode "configured"}}{{range resources $d}}{{template "table" .}}{{end}}{{else}}{{range $d.Objects}}{{if .Tables}}<h3>{{.Name}}</h3>{{range .Tables}}{{template "table" .}}{{end}}{{end}}{{end}}{{end}}{{end}}{{range $section.Items}}<article class="evidence" id="{{.Code}}">{{if not (isSummary .Code)}}<h3><span class="badge {{.Status}}">{{status .Status}}</span> {{.Name}}</h3>{{end}}{{if .Reason}}<p class="gap">{{.Reason}}</p>{{end}}{{range .Evidence}}{{if or .Value .Tables .Executions}}<div id="{{.ID}}"><h4>{{.ObjectName}}</h4><p>{{.Value}}</p>{{if .Reason}}<p class="gap">{{.Reason}}</p>{{end}}{{if .Threshold}}<p class="scope">判定口径：{{.Threshold}}</p>{{end}}{{range .Gaps}}<p class="gap">证据缺口：{{.}}</p>{{end}}{{if or (not .Executions) (ne (index .Executions 0).Kind "sql")}}{{range .Tables}}{{template "table" .}}{{end}}{{end}}{{range .Executions}}{{template "execution" .}}{{end}}{{if and .Advice (ne .Status "NORMAL")}}<p>处理建议：{{.Advice}}</p>{{end}}{{if .Evidence}}<pre>{{.Evidence}}</pre>{{end}}{{if .Source}}<p class="note">来源：{{.Source}} · {{time .CollectedAt}}</p>{{end}}</div>{{else}}<p class="gap">{{.Reason}}</p>{{end}}{{end}}</article>{{end}}</section>{{end}}
{{range $d.Objects}}<section class="object" id="object-{{.ID}}"><details><summary>{{.Name}} 原始补充检查</summary>{{range .Supplement}}<h4><span class="badge {{.Status}}">{{status .Status}}</span> {{.Name}}</h4><p>{{.Value}} {{.Reason}}</p>{{if .Evidence}}<pre>{{.Evidence}}</pre>{{end}}{{end}}</details></section>{{end}}
{{if ne $d.Mode "configured"}}<h2 id="catalogue">39 项检查目录</h2><table class="catalogue"><thead><tr><th>手册编号</th><th>检查项目</th><th>结论</th><th>证据完整性</th><th>范围或缺失原因</th></tr></thead><tbody>{{range $d.Items}}<tr><td><a href="#{{.Code}}">{{.Code}}</a></td><td>{{.Section}} / {{.Name}}</td><td><span class="badge {{.Status}}">{{status .Status}}</span></td><td>{{if eq .Status "NOT_RUN"}}未执行{{else if eq .Status "NOT_APPLICABLE"}}不适用{{else if .Complete}}已取得{{else}}缺口 {{.Missing}} 处{{end}}</td><td>{{if .Reason}}{{.Reason}}{{else}}{{len .Evidence}} 份对象证据{{end}}</td></tr>{{end}}</tbody></table>
{{end}}<h2>报告范围与限制</h2><ul>{{range $d.Limitations}}<li>{{.}}</li>{{end}}</ul><p class="foot">HTML、PDF 与页面摘要共享本次冻结快照。重新生成不重新检查服务器，也不读取新的资源历史。正文仅列关键结果；完整命令、SQL 与输出保存在任务检查详情。历史任务已有的采集截断会保留原标记。</p>
</main></body></html>
{{define "table"}}{{if .Title}}<p class="table-title">{{.Title}}</p>{{end}}<div class="table-scroll"><table{{if and .Columns (eq (index .Columns 0) "Pod")}} class="pod-table"{{end}}><thead><tr>{{range .Columns}}<th>{{.}}</th>{{end}}</tr></thead><tbody>{{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{else}}<tr><td colspan="{{len .Columns}}">本次查询未返回行；是否能判为正常仍以本项结论与权限/范围说明为准。</td></tr>{{end}}</tbody></table></div>{{if .Note}}<p class="note">{{.Note}}</p>{{end}}{{end}}

{{define "execution"}}<div class="execution"><p class="note">实际执行 {{.Kind}} · {{time .StartedAt}} ～ {{time .FinishedAt}} · 退出码 {{.ExitCode}}</p><details open><summary>执行命令或 SQL</summary><pre>{{.Command}}</pre></details><details open><summary>标准输出</summary><pre>{{if .Stdout}}{{.Stdout}}{{else}}（无输出）{{end}}</pre></details>{{if .Stderr}}<p class="gap">标准错误</p><pre>{{.Stderr}}</pre>{{end}}{{if .Error}}<p class="gap">执行失败：{{.Error}}</p>{{end}}{{if .Truncated}}<p class="gap">输出已截断，不能视为完整结果。</p>{{end}}</div>{{end}}
